<Project Sdk="Microsoft.NET.Sdk">
  <!-- 文件职责：Demo 领域测试项目，只引用 Demo Domain，使用 xUnit 覆盖实体构造、名称去空白、空名拒绝、名称与描述长度上限、DemoId 格式化与解析、校验错误，测试保持纯内存且不依赖数据库。 -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);3261</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Tests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Modules/Demo/Domain/Fsso.Modules.Demo.Domain.fsproj" />
  </ItemGroup>
</Project>
