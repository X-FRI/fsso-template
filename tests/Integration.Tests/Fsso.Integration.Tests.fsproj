<Project Sdk="Microsoft.NET.Sdk">
  <!-- 文件职责：集成测试项目，引用 Demo 各层、共享内核、数据库、组合根与 Host（不引用 Notes），启动临时数据库验证 HTTP、存储和 OpenAPI 行为；仅调用 deleteDb 的用例清理临时库，Host 与 OpenAPI 用例不删除数据库。 -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);3261</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Support.fs" />
    <Compile Include="StoreTests.fs" />
    <Compile Include="HostTests.fs" />
    <Compile Include="OpenApiTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Modules/Demo/Domain/Fsso.Modules.Demo.Domain.fsproj" />
    <ProjectReference Include="../../src/Modules/Demo/Application/Fsso.Modules.Demo.Application.fsproj" />
    <ProjectReference Include="../../src/Modules/Demo/Infrastructure/Fsso.Modules.Demo.Infrastructure.fsproj" />
    <ProjectReference Include="../../src/Modules/Demo/Api/Fsso.Modules.Demo.Api.fsproj" />
    <ProjectReference Include="../../src/Shared/Fsso.SharedKernel/Fsso.SharedKernel.fsproj" />
    <ProjectReference Include="../../src/Shared/Fsso.Database/Fsso.Database.fsproj" />
    <ProjectReference Include="../../src/Composition/Fsso.Composition/Fsso.Composition.fsproj" />
    <ProjectReference Include="../../src/Host/Fsso.Host.fsproj" />
  </ItemGroup>
</Project>
