<Project Sdk="Microsoft.NET.Sdk">
  <!-- 文件职责：共享 Api 项目，编译 DTO、HTTP 结果映射、模块描述符和 OpenAPI 支持，供 Demo 与 Notes 的 Api 层复用统一契约工具，并保持错误响应结构在各模块一致。 -->
  <PropertyGroup>
    <RootNamespace>Fsso.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="SharedDtos.fs" />
    <Compile Include="HttpResults.fs" />
    <Compile Include="ModuleDescriptor.fs" />
    <Compile Include="OpenApiSupport.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Fsso.SharedKernel/Fsso.SharedKernel.fsproj" />
  </ItemGroup>
</Project>
